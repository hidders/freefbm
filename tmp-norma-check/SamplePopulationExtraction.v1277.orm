	<cp:CustomPropertyGroup id="_8C4DACEB-8F01-4811-9BFB-FA6BD811F9BC" name="jfe" isDefault="false">
		<cp:PropertyDefinitions>
			<cp:Definition id="_1999D771-B60B-462D-B426-95080C17B885" name="jfeType" description="The name of a jfe type to create for this object type or objectified link. A value of - (hyphen) indicates the object type name." category="jfe" dataType="String" ORMTypes="EntityType, ValueType, FactType" />
			<cp:Definition id="_A30CB996-5DD8-4AB0-BCAA-4033E30CE2E9" name="jfeRoleNumber" description="The 1-based number for this role." category="jfe" dataType="Decimal" ORMTypes="Role" />
			<cp:Definition id="_D307E3E7-D362-40A0-8D21-38C6EB10BA5C" name="jfeRoleName" description="The name of the jfe role on a fact type marked as a jfe link. If the role name is on an objectified role, then exactly one of either the objectified fact type or the link fact type for that role must be a link. All of the role information for an objectified unary must be on the link fact type roles." category="jfe" dataType="String" ORMTypes="Role" />
			<cp:Definition id="_E30815A1-3B35-4D65-AD7B-3E1FC6200689" name="jfeRoleAccessor" description="The accessor name for a jfe role. Refers to the opposite type or objectification." category="jfe" dataType="String" ORMTypes="Role" />
			<cp:Definition id="_EA724B60-6C1B-4331-91F9-1FB92DD2111F" name="jfeLink" description="The name of the jfe link associated with this fact type. If an objectified fact type is a link then no link fact type may also be a link." category="jfe" dataType="String" ORMTypes="FactType, SubtypeFact" />
			<cp:Definition id="_5D7C01E4-5263-4230-BDC8-B6924372D6B2" name="jfeDirective" description="A role mapping directive:&#xD;&#xA;'absorb' on a functional binary role indicates that the properties from the opposite object type (not a jfeType) will be pulled into the role player. Recurses if the role player itself is absorbed. Used on fact types that are not jfe links.&#xD;&#xA;'compose' on a functional binary role indicates a composition relationship.&#xD;&#xA;'delete' on any role in a jfe link indicates that the role player is deleted when the link is deleted. This is implied by the 'compose' directive." category="jfe" dataType="String" ORMTypes="Role" />
			<cp:Definition id="_55111152-145C-42E0-B4FC-2F1443E985B1" name="jfeProp" description="The name of a jfe property. Set opposite the type the property is on, like a role name. If this property begins with # it should be in a two-role uniqueness constraint with another role with an accessor matching this name (without the #)." category="jfe" dataType="String" ORMTypes="Role" />
			<cp:Definition id="_1B0232CF-F944-4C8D-A9CC-D0FA187F77E7" name="jfeModel" description="The name for the associated jfe model. Defaults to the jfeDefaultModel on the ORM model." category="jfe" dataType="String" ORMTypes="EntityType, ValueType, FactType, SubtypeFact" />
			<cp:Definition id="_7F26E5C1-AF6B-44C3-9E4D-5C8EA7945A4F" name="jfeRoleConsolidator" description="JFE consolidation allows multiple collections with a share role player to be iterated from that role player using a single collection name. For example, a top-level 'ErrorState' object may consolidate multiple kinds of error objects into a single 'errors' consolidator." category="jfe" dataType="String" ORMTypes="Role" />
			<cp:Definition id="_CA078A66-A11C-47FC-AA67-95DA9E385769" name="jfeEnumProp" description="Use on the client as the primary property name if the object type or role has a value constraint with all discrete values. If this is set on a unary, then it is combining with other unaries that have the same jfeEnumProp value. The role fields are preempted in this case as follows: jfeRoleNumber is the enum value, jfeRoleName is the name of the generated enum type, and jfeRoleAccessor is the enum key. The numbers should be bit fields (1,2,4,8...) for non-exclusive unaries." category="jfe" dataType="String" ORMTypes="Role" />
			<cp:Definition id="_B65677D8-20CD-4909-9A88-BA075BDEE134" name="jfeJSONFilter" description="Add JSON filter kinds for JFE objects, links, and properties using space delimited filter names. For example 'Export Cache' will remove an item from both the 'Export' and 'Cache' filter kinds. Special care is needed for enum property. The default behavior is to write the enum value. If you want to write the non-enum names then add a plus sign after the filter name, so 'Export+' will switch to the enum form instead of eliminating the marked property." category="jfe" dataType="String" ORMTypes="EntityType, ValueType, FactType, SubtypeFact, Role" />
			<cp:Definition id="_B35A5BCF-EB46-4162-8BE3-409771B30964" name="jfeDefaultModel" description="The default jfe model name for this ORM model. Used if a jfeModel property is not set." category="jfe" dataType="String" ORMTypes="EntityType, ValueType, FactType, Role, SubtypeFact, UniquenessConstraint, MandatoryConstraint, FrequencyConstraint, RingConstraint, EqualityConstraint, ExclusionConstraint, SubsetConstraint, ValueComparisonConstraint, ElementGrouping" />
			<cp:Definition id="_3F90596C-2D30-44BF-AC0F-B95C346B6486" name="jfeFilteredJSONModels" description="The JFE JSON exporter can apply filters at the model, object, link, and property levels. To remove an entire JFE model from a filter list it here with a : (colon) delimiter between the model name and the filter name. For example, myDerived:Export will remove the 'myDerived' JFE model from the 'Export' JSON target kind. Model and target names can both be repeated in different combinations (space delimited list)." category="jfe" dataType="String" ORMTypes="EntityType, ValueType, FactType, Role, SubtypeFact, UniquenessConstraint, MandatoryConstraint, FrequencyConstraint, RingConstraint, EqualityConstraint, ExclusionConstraint, SubsetConstraint, ValueComparisonConstraint, ElementGrouping" />
			<cp:Definition id="_977D4C44-4493-40EE-8A57-16CEE14A92E4" name="jfeEnumeration" description="Provide an alternate name for a jfe enumeration generated from a value constraint." category="jfe" dataType="String" ORMTypes="EntityType, ValueType, FactType, Role, SubtypeFact, UniquenessConstraint, MandatoryConstraint, FrequencyConstraint, RingConstraint, EqualityConstraint, ExclusionConstraint, SubsetConstraint, ValueComparisonConstraint, ElementGrouping" />
			<cp:Definition id="_0D6A8357-89A0-4DCC-9CEE-702B7A24F178" name="jfeGroup" description="The jfe group declaration used with a type declaration to specify the storage location for a top-level object. Use a - to store with the current type and a space delimited list of type names for multiple types. Use MODEL.TYPE to specify a supertype from an external model. If a group is specified on a supertype then the subtpes default to storage with the supertype instead of with their own types." category="jfe" dataType="String" ORMTypes="EntityType, ValueType, FactType" />
			<cp:Definition id="_9F97AC5D-F425-4234-BF73-472F50298138" name="jfeTypeIsSingleton" description="Used as a modifier for a jfeType property. Set to a non-zero value to create at most one instance of this type per fact base." category="jfe" dataType="Decimal" ORMTypes="EntityType, ValueType, FactType" />
		</cp:PropertyDefinitions>
	</cp:CustomPropertyGroup>
</ormRoot:ORM2>
